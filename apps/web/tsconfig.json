{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@hexa/shared/permissions": ["../../packages/shared/src/permissions.ts"],
      "@hexa/shared/billing": ["../../packages/shared/src/billing.ts"],
      "@hexa/shared/workday": ["../../packages/shared/src/workday.ts"],
      "@hexa/shared/contractCharges": ["../../packages/shared/src/contractCharges.ts"]
    }
  },
  "include": ["src"]
}
