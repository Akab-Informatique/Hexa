{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@nexo/shared": ["packages/shared/src/index.ts"],
      "@nexo/shared/migrate": ["packages/shared/src/migrate.ts"]
    }
  },
  "include": ["packages/*/src", "apps/*/src", "modules/*", "tests"],
  "exclude": ["node_modules", "Planning"]
}
