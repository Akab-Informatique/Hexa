{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@hexa/shared": ["packages/shared/src/index.ts"],
      "@hexa/shared/migrate": ["packages/shared/src/migrate.ts"],
      "@hexa/shared/permissions": ["packages/shared/src/permissions.ts"],
      "@hexa/shared/billing": ["packages/shared/src/billing.ts"],
      "@hexa/shared/workday": ["packages/shared/src/workday.ts"],
      "@hexa/shared/contractCharges": ["packages/shared/src/contractCharges.ts"]
    }
  },
  "include": ["packages/*/src", "apps/instance/src", "apps/console/src", "apps/updater/src", "modules/*", "tests"],
  "exclude": ["node_modules", "Planning"]
}
