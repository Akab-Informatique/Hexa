APP_VERSION={{APP_VERSION}}
APP_PORT={{APP_PORT}}

# --- Database ---
POSTGRES_DB=nexo
POSTGRES_USER=nexo
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}

# --- First sign-in (only used while the instance has no users; change the password at first login) ---
