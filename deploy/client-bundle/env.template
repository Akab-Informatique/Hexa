INITIAL_ADMIN_PASSWORD={{INITIAL_ADMIN_PASSWORD}}
# Demo data seeded once on the very first start (none | accounting | bookkeeping | tax). Use "none" for a real firm.
SEED_PROFILE={{SEED_PROFILE}}
# Encrypts two-factor secrets and integration credentials. Do NOT change after first start.
APP_SECRET={{APP_SECRET}}

# --- Update machinery ---
UPDATER_TOKEN={{UPDATER_TOKEN}}
INSTANCE_ADMIN_TOKEN={{INSTANCE_ADMIN_TOKEN}}
GHCR_USER={{GHCR_USER}}
GHCR_TOKEN={{GHCR_TOKEN}}

