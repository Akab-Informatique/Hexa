# Optional nginx site for {{CLIENT_NAME}} -> {{SERVER_NAMES}}
# Only for servers WITHOUT Nginx Proxy Manager. With NPM, add a Proxy Host instead (see README).
# Copy to /etc/nginx/conf.d/ (or sites-available + symlink), then:  nginx -t && nginx -s reload
# Get a certificate first, e.g.:  certbot --nginx {{CERTBOT_DOMAINS}}   (certbot will add the 443 block for you)

server {
    listen 80;
    server_name {{SERVER_NAMES}};

    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:{{APP_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
    }
}

# Needed once in the http {} block of nginx.conf if you don't already have it:
# map $http_upgrade $connection_upgrade { default upgrade; '' close; }
