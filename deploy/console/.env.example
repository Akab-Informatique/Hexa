POSTGRES_PASSWORD=change-me
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-long-and-random
# 32+ random chars. Encrypts client license keys at rest. Back it up: losing it means rotating every key.
CONSOLE_SECRET=
# Public HTTPS URL clients use to reach this console (goes into every bundle).
PUBLIC_URL=https://console.example.com
# Base domain for each client's default address (e.g. hexa.akab.ca gives clienta.hexa.akab.ca). Needs a wildcard DNS
# record *.<this> pointing at the client-facing server. Empty = no default addresses; each client needs an explicit domain.
CLIENT_BASE_DOMAIN=
INSTANCE_IMAGE=ghcr.io/akab-informatique/hexa-instance
UPDATER_IMAGE=ghcr.io/akab-informatique/hexa-updater
# Read-only GitHub token (read:packages) given to clients so they can pull private images.
GHCR_PULL_USER=
GHCR_PULL_TOKEN=
# Optional: shows a "Tell me when it launches" button on the marketing page (mailto).
SITE_CONTACT_EMAIL=
# Lets CI register releases: POST /api/releases with "Authorization: Bearer <this>".
RELEASE_TOKEN=
